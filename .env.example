# Phase D1 is disposable-local simulation only. Never enable on hosting.
PUNA_ORDERING_LOCAL_ENABLED=false
PUNA_ORDERING_ACCEPT_NEW=false

# D2 callback preparation; separate process, never enabled by app startup.
PUNA_D2_RELAY_ENABLED=false
