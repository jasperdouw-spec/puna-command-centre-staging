DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
BOOTSTRAP_TOKEN=
STAGING_TEST_ORDERS_ENABLED=false

# Phase C: disabled by default. Migration is not run by startup or build.
PUNA_LIVE_KITCHEN_ENABLED=false
PUNA_KITCHEN_PUBLIC_PREVIEW=false
